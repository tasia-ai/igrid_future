:VERSION 1         # -------------------------- 

BEGIN;

CREATE TABLE os_groups_groups (
  "GroupID" char(36) Primary Key NOT NULL default '',
  "Location" varchar(255) NOT NULL default '',
  "Name" varchar(255) NOT NULL default '',
  "Charter" text NOT NULL,
  "InsigniaID" char(36) NOT NULL default '',
  "FounderID" char(36) NOT NULL default '',
  "MembershipFee" integer NOT NULL default '0',
  "OpenEnrollment" varchar(255) NOT NULL default '',
  "ShowInList" integer NOT NULL default '0',
  "AllowPublish" integer NOT NULL default '0',
  "MaturePublish" integer NOT NULL default '0',
  "OwnerRoleID" char(36) NOT NULL default ''
);


CREATE TABLE os_groups_membership (
  "GroupID"char(36) NOT NULL default '',
  "PrincipalID" VARCHAR(255) NOT NULL default '',
  "SelectedRoleID" char(36) NOT NULL default '',
  "Contribution" integer NOT NULL default '0',
  "ListInProfile" integer NOT NULL default '1',
  "AcceptNotices" integer NOT NULL default '1',
  "AccessToken" char(36) NOT NULL default '',
  constraint os_groupmemberpk primary key ("GroupID", "PrincipalID")
);



CREATE TABLE os_groups_roles (
  "GroupID" char(36) NOT NULL default '',
  "RoleID" char(36) NOT NULL default '',
  "Name" varchar(255) NOT NULL default '',
  "Description" varchar(255) NOT NULL default '',
  "Title" varchar(255) NOT NULL default '',
  "Powers" bigint NOT NULL default 0,
  constraint os_grouprolepk PRIMARY KEY  ("GroupID","RoleID")
);


CREATE TABLE os_groups_rolemembership (
  "GroupID" char(36) NOT NULL default '',
  "RoleID" char(36) NOT NULL default '',
  "PrincipalID" VARCHAR(255) NOT NULL default '',
  constraint os_grouprolememberpk PRIMARY KEY  ("GroupID","RoleID","PrincipalID")
);


CREATE TABLE os_groups_invites (
  "InviteID" char(36) NOT NULL default '',
  "GroupID" char(36) NOT NULL default '',
  "RoleID" char(36) NOT NULL default '',
  "PrincipalID" VARCHAR(255) NOT NULL default '',
  "TMStamp" timestamp NOT NULL default now(),
  constraint os_groupinvitespk PRIMARY KEY  ("InviteID")
);
--  UNIQUE KEY "PrincipalGroup" ("GroupID","PrincipalID")


CREATE TABLE os_groups_notices (
  "GroupID" char(36) NOT NULL default '',
  "NoticeID" char(36) NOT NULL default '',
  "TMStamp" integer NOT NULL default '0',
  "FromName" varchar(255) NOT NULL default '',
  "Subject" varchar(255) NOT NULL default '',
  "Message" text NOT NULL,
  "HasAttachment" integer NOT NULL default '0',
  "AttachmentType" integer NOT NULL default '0',
  "AttachmentName" varchar(128) NOT NULL default '',
  "AttachmentItemID" char(36) NOT NULL default '',
  "AttachmentOwnerID" varchar(255) NOT NULL default '',
  constraint os_groupsnoticespk PRIMARY KEY  ("NoticeID")
);
--  KEY  "GroupID" ("GroupID"),
--  KEY "TMStamp" ("TMStamp")

CREATE TABLE os_groups_principals (
  "PrincipalID" VARCHAR(255) NOT NULL default '',
  "ActiveGroupID" char(36) NOT NULL default '',
  constraint os_groupprincpk PRIMARY KEY  ("PrincipalID")
);

COMMIT;

:VERSION 2         # -------------------------- 

BEGIN;


COMMIT;



:VERSION 3

BEGIN;
-- Convert UUID columns in place; retain groups, members, notices and invitations.
ALTER TABLE os_groups_groups ALTER COLUMN "GroupID" DROP DEFAULT;
ALTER TABLE os_groups_groups ALTER COLUMN "GroupID" TYPE uuid USING coalesce(nullif(trim("GroupID"), ''), '00000000-0000-0000-0000-000000000000')::uuid;
ALTER TABLE os_groups_groups ALTER COLUMN "InsigniaID" DROP DEFAULT;
ALTER TABLE os_groups_groups ALTER COLUMN "InsigniaID" TYPE uuid USING coalesce(nullif(trim("InsigniaID"), ''), '00000000-0000-0000-0000-000000000000')::uuid;
ALTER TABLE os_groups_groups ALTER COLUMN "FounderID" DROP DEFAULT;
ALTER TABLE os_groups_groups ALTER COLUMN "FounderID" TYPE uuid USING coalesce(nullif(trim("FounderID"), ''), '00000000-0000-0000-0000-000000000000')::uuid;
ALTER TABLE os_groups_groups ALTER COLUMN "OwnerRoleID" DROP DEFAULT;
ALTER TABLE os_groups_groups ALTER COLUMN "OwnerRoleID" TYPE uuid USING coalesce(nullif(trim("OwnerRoleID"), ''), '00000000-0000-0000-0000-000000000000')::uuid;
ALTER TABLE os_groups_membership ALTER COLUMN "GroupID" DROP DEFAULT;
ALTER TABLE os_groups_membership ALTER COLUMN "GroupID" TYPE uuid USING coalesce(nullif(trim("GroupID"), ''), '00000000-0000-0000-0000-000000000000')::uuid;
ALTER TABLE os_groups_membership ALTER COLUMN "SelectedRoleID" DROP DEFAULT;
ALTER TABLE os_groups_membership ALTER COLUMN "SelectedRoleID" TYPE uuid USING coalesce(nullif(trim("SelectedRoleID"), ''), '00000000-0000-0000-0000-000000000000')::uuid;
ALTER TABLE os_groups_membership ALTER COLUMN "AccessToken" DROP DEFAULT;
ALTER TABLE os_groups_membership ALTER COLUMN "AccessToken" TYPE uuid USING coalesce(nullif(trim("AccessToken"), ''), '00000000-0000-0000-0000-000000000000')::uuid;
ALTER TABLE os_groups_roles ALTER COLUMN "GroupID" DROP DEFAULT;
ALTER TABLE os_groups_roles ALTER COLUMN "GroupID" TYPE uuid USING coalesce(nullif(trim("GroupID"), ''), '00000000-0000-0000-0000-000000000000')::uuid;
ALTER TABLE os_groups_roles ALTER COLUMN "RoleID" DROP DEFAULT;
ALTER TABLE os_groups_roles ALTER COLUMN "RoleID" TYPE uuid USING coalesce(nullif(trim("RoleID"), ''), '00000000-0000-0000-0000-000000000000')::uuid;
ALTER TABLE os_groups_rolemembership ALTER COLUMN "GroupID" DROP DEFAULT;
ALTER TABLE os_groups_rolemembership ALTER COLUMN "GroupID" TYPE uuid USING coalesce(nullif(trim("GroupID"), ''), '00000000-0000-0000-0000-000000000000')::uuid;
ALTER TABLE os_groups_rolemembership ALTER COLUMN "RoleID" DROP DEFAULT;
ALTER TABLE os_groups_rolemembership ALTER COLUMN "RoleID" TYPE uuid USING coalesce(nullif(trim("RoleID"), ''), '00000000-0000-0000-0000-000000000000')::uuid;
ALTER TABLE os_groups_invites ALTER COLUMN "InviteID" DROP DEFAULT;
ALTER TABLE os_groups_invites ALTER COLUMN "InviteID" TYPE uuid USING coalesce(nullif(trim("InviteID"), ''), '00000000-0000-0000-0000-000000000000')::uuid;
ALTER TABLE os_groups_invites ALTER COLUMN "GroupID" DROP DEFAULT;
ALTER TABLE os_groups_invites ALTER COLUMN "GroupID" TYPE uuid USING coalesce(nullif(trim("GroupID"), ''), '00000000-0000-0000-0000-000000000000')::uuid;
ALTER TABLE os_groups_invites ALTER COLUMN "RoleID" DROP DEFAULT;
ALTER TABLE os_groups_invites ALTER COLUMN "RoleID" TYPE uuid USING coalesce(nullif(trim("RoleID"), ''), '00000000-0000-0000-0000-000000000000')::uuid;
ALTER TABLE os_groups_notices ALTER COLUMN "GroupID" DROP DEFAULT;
ALTER TABLE os_groups_notices ALTER COLUMN "GroupID" TYPE uuid USING coalesce(nullif(trim("GroupID"), ''), '00000000-0000-0000-0000-000000000000')::uuid;
ALTER TABLE os_groups_notices ALTER COLUMN "NoticeID" DROP DEFAULT;
ALTER TABLE os_groups_notices ALTER COLUMN "NoticeID" TYPE uuid USING coalesce(nullif(trim("NoticeID"), ''), '00000000-0000-0000-0000-000000000000')::uuid;
ALTER TABLE os_groups_notices ALTER COLUMN "AttachmentItemID" DROP DEFAULT;
ALTER TABLE os_groups_notices ALTER COLUMN "AttachmentItemID" TYPE uuid USING coalesce(nullif(trim("AttachmentItemID"), ''), '00000000-0000-0000-0000-000000000000')::uuid;
ALTER TABLE os_groups_principals ALTER COLUMN "ActiveGroupID" DROP DEFAULT;
ALTER TABLE os_groups_principals ALTER COLUMN "ActiveGroupID" TYPE uuid USING coalesce(nullif(trim("ActiveGroupID"), ''), '00000000-0000-0000-0000-000000000000')::uuid;
ALTER TABLE os_groups_roles ALTER COLUMN "Powers" DROP DEFAULT;
ALTER TABLE os_groups_roles ALTER COLUMN "Powers" TYPE varchar(36) USING "Powers"::text;
ALTER TABLE os_groups_roles ALTER COLUMN "Powers" SET DEFAULT '';
COMMIT;

:VERSION 4

BEGIN;

ALTER TABLE IF EXISTS os_groups_notices  
  ALTER COLUMN "AttachmentItemID" SET DEFAULT '00000000-0000-0000-0000-000000000000'
;

COMMIT;
