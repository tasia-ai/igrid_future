<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- Single assembly for the whole Phlox engine: the compiler/VM that used to
         live in Source\InWorldz.Phlox plus the OpenSim-facing engine host that
         lived beside it. The engine's registered name is unchanged
         (PhloxEngine.Name == "InWorldz.Phlox"), which is what OpenSim.ini selects on. -->
    <AssemblyName>Phlox.ScriptEngine</AssemblyName>
    <RootNamespace>Phlox.ScriptEngine</RootNamespace>
    <!-- Matches YEngine: this lib transitively references the OpenSim app project, which
         under solution-level `dotnet publish -r` produces a duplicate apphost relative path
         (NETSDK1152). Suppress, as YEngine does, so publish succeeds. -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    <PreserveCompilationContext>false</PreserveCompilationContext>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Phlox sources predate ImplicitUsings; the Tranquillity root Directory.Build.props
         sets ImplicitUsings=enable, so override it back to disable here (and Nullable=disable). -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TieredCompilationQuickJit>false</TieredCompilationQuickJit>
    <NoWarn>CA1416,SYSLIB0011,SYSLIB0014,SYSLIB0039</NoWarn>
  </PropertyGroup>

  <!-- ANTLR3-generated sources and the duplicate grammar/generated/ copies are
       superseded by the ANTLR4 visitors compiled from Compiler/ and ByteCompiler/. -->
  <ItemGroup>
    <Compile Remove="grammar\generated\**\*.cs" />
    <Compile Remove="Compiler\Def.cs" />
    <Compile Remove="Compiler\Types.cs" />
    <Compile Remove="Compiler\Analyze.cs" />
    <Compile Remove="Compiler\Gen.cs" />
  </ItemGroup>

  <!-- NuGet deps Phlox brings in (not used elsewhere in Tranquillity) -->
  <ItemGroup>
    <PackageReference Include="protobuf-net" Version="3.2.56" />
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
    <PackageReference Include="StringTemplate4" Version="4.0.8" />
    <PackageReference Include="System.Data.SQLite" Version="2.0.4" />
    <PackageReference Include="SQLite" Version="3.53.4" />
  </ItemGroup>

  <!-- C5 via develop's Library/C5.dll (single identity - avoids the dual-C5 TypeLoadException). -->
  <ItemGroup>
    <Reference Include="C5" HintPath="..\..\Library\C5.dll" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenSim.Framework\OpenSim.Framework.csproj" />
    <ProjectReference Include="..\OpenSim.Region.Framework\OpenSim.Region.Framework.csproj" />
    <ProjectReference Include="..\OpenSim.Region.ScriptEngine.Shared\OpenSim.Region.ScriptEngine.Shared.csproj" />
    <ProjectReference Include="..\OpenSim.Region.OptionalModules\OpenSim.Region.OptionalModules.csproj" />
  </ItemGroup>

  <!-- This project used to set EnableDefaultItems=false and hand-list every file, which
       meant a newly added .cs was silently left out of the build. Now that the compiler
       and VM sources are merged in, the SDK's default globbing picks up both halves; only
       the superseded ANTLR3 outputs above are excluded. -->

</Project>