<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
<AssemblyName>TasiaAddons.Quic</AssemblyName>
    <RootNamespace>TasiaAddons.Quic</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CA2252</NoWarn>   <!-- System.Net.Quic is a preview API -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Robust side: the QUIC proxy ServiceConnector, moved out of OpenSim.Server.Handlers.dll -->
    <Compile Include="QuicProxyConnector.cs" />
    <Compile Include="QuicServerModule.cs" />
    <Compile Include="QuicViewerTransport.cs" />
    <Compile Include="PacketFraming.cs" />
    <Compile Include="QuicServerConfig.cs" />
    <Compile Include="QuicClientConnection.cs" />
    <!-- Tranquillity discovers region modules through IPluginRegistryProvider,
         not Mono.Addins [Extension]. Must be listed explicitly: this project sets
         EnableDefaultCompileItems=false, so an unlisted file is never compiled and
         its errors never surface. -->
    <Compile Include="PluginRegistration.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="log4net">
      <HintPath>$(SolutionDir)/bin/log4net.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="OpenSim.Framework">
      <HintPath>$(SolutionDir)/bin/OpenSim.Framework.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="OpenSim.Framework.Servers">
      <HintPath>$(SolutionDir)/bin/OpenSim.Framework.Servers.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="OpenSim.Framework.Servers.HttpServer">
      <HintPath>$(SolutionDir)/bin/OpenSim.Framework.Servers.HttpServer.dll</HintPath>
      <Private>False</Private>
    </Reference>    <Reference Include="OpenSim.Region.Framework">
      <HintPath>$(SolutionDir)/bin/OpenSim.Region.Framework.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="OpenSim.Services.Interfaces">
      <HintPath>$(SolutionDir)/bin/OpenSim.Services.Interfaces.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="OpenSim.Server.Base">
      <HintPath>$(SolutionDir)/bin/OpenSim.Server.Base.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="OpenSim.Server.Handlers">
      <HintPath>$(SolutionDir)/bin/OpenSim.Server.Handlers.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>

  </ItemGroup>
  <ItemGroup>
    <Reference Include="xmlrpc" HintPath="..\..\Library\xmlrpc.dll" />
  </ItemGroup>
  <ItemGroup>
    <!-- Private="false" is REQUIRED, not cosmetic. Every reference below is
         already loaded in the host process (OpenSim.Server.RegionServer). If
         MSBuild copies the dependency next to the addon, the plugin loader
         loads a SECOND Assembly instance from that copy. Same file, same path,
         same full type name - but a different Assembly object, so every
         `is SomeHostType` test in the addon is false and every cast throws.
         That is why TasiaAddons.Quic could not find LLUDPServerShim while the
         scene demonstrably had it attached under exactly that name.
         Keep these references Private=false so the addon's dependencies always
         unify with the host's already-loaded assemblies. -->
    <ProjectReference Include="..\..\Source\OpenSim.Framework\OpenSim.Framework.csproj" Private="false" />
    <ProjectReference Include="..\..\Source\OpenSim.Framework.Servers\OpenSim.Framework.Servers.csproj" Private="false" />
    <ProjectReference Include="..\..\Source\OpenSim.Framework.Servers.HttpServer\OpenSim.Framework.Servers.HttpServer.csproj" Private="false" />
    <ProjectReference Include="..\..\Source\OpenSim.Region.ClientStack.LindenUDP\OpenSim.Region.ClientStack.LindenUDP.csproj" Private="false" />
    <ProjectReference Include="..\..\Source\OpenSim.Region.Framework\OpenSim.Region.Framework.csproj" Private="false" />
    <ProjectReference Include="..\..\Source\OpenSim.Server.Base\OpenSim.Server.Base.csproj" Private="false" />
    <ProjectReference Include="..\..\Source\OpenSim.Server.Handlers\OpenSim.Server.Handlers.csproj" Private="false" />
    <ProjectReference Include="..\..\Source\OpenSim.Services.Interfaces\OpenSim.Services.Interfaces.csproj" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="log4net" Version="3.3.2" />
  </ItemGroup>
</Project>
