[Unit]
Description=OpenSim Helper Bridge
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/opensim_helper_bridge
Environment=OS_HELPER_CONFIG=/opt/opensim_helper_bridge/config.json
ExecStart=/usr/bin/python3 /opt/opensim_helper_bridge/app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
