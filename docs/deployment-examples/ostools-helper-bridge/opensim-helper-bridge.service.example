[Unit]
Description=OpenSim Helper Bridge (currency/landtool XML-RPC)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/html/web/ostools
Environment=OS_HELPER_CONFIG=/var/www/html/web/ostools/config.json
ExecStart=/usr/bin/python3 /var/www/html/web/ostools/app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
