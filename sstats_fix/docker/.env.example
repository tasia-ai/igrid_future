# =============================================================================
# SStats + OpenSim + dotnet-monitor Environment Variables
# =============================================================================
# Copy: cp .env.example .env

# --- MySQL (shared by OpenSim C# + Python Dashboard) ---
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DB=opensim
MYSQL_USER=opensim
MYSQL_PASS=changeme
MYSQL_ROOT_PASS=changeme-root

# --- OpenSim SStats (C# module auth) ---
SSTATS_PASSWORD=sstats2026
SSTATS_SECRET=

# --- Dashboard auth (Python app at :8080) ---
DASHBOARD_USER=admin
DASHBOARD_PASS=changeme

# --- dotnet-monitor auth (API at :52323) ---
MONITOR_USER=admin
MONITOR_PASSWORD=changeme-monitor
