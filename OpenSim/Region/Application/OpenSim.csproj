<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <OutputType>Exe</OutputType>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    <AssemblyTitle>OpenSim</AssemblyTitle>
    <Company>http://opensimulator.org</Company>
    <Product>OpenSim</Product>
    <Description>The executable for regions simulator</Description>
    <Copyright>OpenSimulator developers</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="NDesk.Options">
      <HintPath>..\..\..\bin\NDesk.Options.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Nini">
      <HintPath>..\..\..\bin\Nini.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="OpenMetaverse">
      <HintPath>..\..\..\bin\OpenMetaverse.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="OpenMetaverse.StructuredData">
      <HintPath>..\..\..\bin\OpenMetaverse.StructuredData.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="OpenMetaverseTypes">
      <HintPath>..\..\..\bin\OpenMetaverseTypes.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="XMLRPC">
      <HintPath>..\..\..\bin\XMLRPC.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Data\OpenSim.Data.csproj" />
    <ProjectReference Include="..\..\Framework\OpenSim.Framework.csproj" />
    <ProjectReference Include="..\..\Framework\Console\OpenSim.Framework.Console.csproj" />
    <ProjectReference Include="..\..\Framework\Monitoring\OpenSim.Framework.Monitoring.csproj" />
    <ProjectReference Include="..\..\Framework\Servers\OpenSim.Framework.Servers.csproj" />
    <ProjectReference Include="..\..\Framework\Servers\HttpServer\OpenSim.Framework.Servers.HttpServer.csproj" />
    <ProjectReference Include="..\CoreModules\OpenSim.Region.CoreModules.csproj" />
    <ProjectReference Include="..\Framework\OpenSim.Region.Framework.csproj" />
    <ProjectReference Include="..\PhysicsModules\SharedBase\OpenSim.Region.PhysicsModules.SharedBase.csproj" />
    <ProjectReference Include="..\..\Server\Base\OpenSim.Server.Base.csproj" />
    <ProjectReference Include="..\..\Services\Base\OpenSim.Services.Base.csproj" />
    <ProjectReference Include="..\..\Services\Interfaces\OpenSim.Services.Interfaces.csproj" />
    <ProjectReference Include="..\..\Services\UserAccountService\OpenSim.Services.UserAccountService.csproj" />
    <ProjectReference Include="..\..\Services\SimulationService\OpenSim.Services.SimulationService.csproj" />
    <ProjectReference Include="..\..\Services\GridService\OpenSim.Services.GridService.csproj" />
    <ProjectReference Include="..\..\Services\Connectors\OpenSim.Services.Connectors.csproj" />
    <ProjectReference Include="..\..\Services\InventoryService\OpenSim.Services.InventoryService.csproj" />
    <ProjectReference Include="..\..\Services\HypergridService\OpenSim.Services.HypergridService.csproj" />
    <ProjectReference Include="..\..\Services\EstateService\OpenSim.Services.EstateService.csproj" />
    <ProjectReference Include="..\..\Data\MySQL\OpenSim.Data.MySQL.csproj" />
    <ProjectReference Include="..\OptionalModules\OpenSim.Region.OptionalModules.csproj" />
    <ProjectReference Include="..\..\Framework\AssetLoader\Filesystem\OpenSim.Framework.AssetLoader.Filesystem.csproj" />
    <ProjectReference Include="..\PhysicsModules\BulletS\OpenSim.Region.PhysicsModule.BulletS.csproj" />
    <ProjectReference Include="..\OptionalModules\AI\OpenSim.Region.OptionalModules.AI.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <!-- Deployment assets are copied into the publish, but managed OpenSim
         assemblies are overlaid from the current source build below. -->
    <DeploymentBinRoot Condition="'$(DeploymentBinRoot)' == ''">$(SolutionDir)\bin</DeploymentBinRoot>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="$(DeploymentBinRoot)\**"
             Exclude="$(DeploymentBinRoot)\OpenSim*.dll;$(DeploymentBinRoot)\OpenSim*.exe;$(DeploymentBinRoot)\OpenSim.runtimeconfig.json;$(DeploymentBinRoot)\OpenSim.deps.json;$(DeploymentBinRoot)\Npgsql.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
	<Content Include="Resources/OpenSim.addin.xml">
	  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	</Content>
  </ItemGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Net.Quic.AppLocalMsQuic" Value="true" />
    <PackageReference Include="log4net" Version="3.2.0" />
    <PackageReference Include="Microsoft.Native.Quic.MsQuic.OpenSSL" Version="2.5.6" PrivateAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Mono.Addins" Version="1.4.1" />
    <PackageReference Include="Mono.Addins.Setup" Version="1.4.1" />
    <PackageReference Include="Mono.Addins.CecilReflector" Version="1.4.1" />
  </ItemGroup>
  <Target Name="CopyAppLocalOpenSslMsQuicToBuild" AfterTargets="Build" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <Copy SourceFiles="$(PkgMicrosoft_Native_Quic_MsQuic_OpenSSL)\build\native\bin\x64\msquic.dll" DestinationFolder="$(TargetDir)" />
  </Target>
  <Target Name="CopyAppLocalOpenSslMsQuic" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <Copy SourceFiles="$(PkgMicrosoft_Native_Quic_MsQuic_OpenSSL)\build\native\bin\x64\msquic.dll" DestinationFolder="$(PublishDir)" />
  </Target>
  <Target Name="OverlayFreshSourceAssembliesOnPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != '' and '$(RuntimeIdentifier)' == 'win-x64'">
    <ItemGroup>
      <!-- Keep the separately-built live AI addon from DeploymentBinRoot;
           overlay every other current-source OpenSim assembly after the
           deployment content copy so stale bin files cannot win. Never copy
           the non-self-contained build apphost over the publish apphost. -->
      <FreshSourceAssembly Include="$(SolutionDir)build\Release\OpenSim*.dll" Exclude="$(SolutionDir)build\Release\OpenSim.Region.OptionalModules.AI.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(FreshSourceAssembly)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="false" />
  </Target>
  <Target Name="CopySmartNpcaiMetadataOnPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != '' and '$(RuntimeIdentifier)' == 'win-x64'">
    <Copy SourceFiles="$(SolutionDir)OpenSim\Region\OptionalModules\AI\Resources\OpenSimAIModule.addin.xml"
          DestinationFiles="$(PublishDir)OpenSim.Region.OptionalModules.AI.addin.xml"
          SkipUnchangedFiles="false" />
  </Target>
</Project>

